        <!-- Butler's home-screen widgets (added before </application> by .github/workflows/android.yml) -->
        <receiver android:name=".MyDayWidget" android:label="My Day" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/myday_widget_info" />
        </receiver>
        <receiver android:name=".ListWidget" android:label="One list" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/list_widget_info" />
        </receiver>
        <service android:name=".WidgetService" android:permission="android.permission.BIND_REMOTEVIEWS" android:exported="false" />
        <!-- The widgets' hidden refresh (round 6): Butler's page with no screen, on ↻ and about every 15 minutes -->
        <service android:name=".HiddenRefresh" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
        <!-- Morning and evening (round 7): its alarms, and setting them again after a restart or an update -->
        <receiver android:name=".Digest" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity android:name=".ListConfigActivity" android:label="Which bucket?" android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
